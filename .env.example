# Copy this file to .env and change the values if needed.

# The full base URL for your running Ollama instance.
# Default is for a local installation.
OLLAMA_BASE_URL=http://localhost:11434

# The port on which the Flask web server will run.
FLASK_PORT=5000

# Set to "True" for development (enables auto-reloading).
# Set to "False" for production.
FLASK_DEBUG=True